{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.automaticqa/coador",
  "title": "Coador",
  "description": "Evidence-backed Android repository knowledge for humans and AI agents",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/automaticqa/coador",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "coador",
      "version": "0.1.0",
      "runtimeHint": "uvx",
      "packageArguments": [
        {"type": "positional", "value": "mcp"},
        {
          "type": "named",
          "name": "--repo",
          "description": "Absolute path to the Android repository",
          "format": "filepath",
          "isRequired": true
        }
      ],
      "transport": {"type": "stdio"}
    }
  ]
}
